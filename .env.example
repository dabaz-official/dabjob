# Copy to .env and adjust. Every variable except AGENT_PROVIDER is
# prefixed with DABJOB_ so a stray shell variable cannot reconfigure the app.

# Where the SQLite database lives. Excluded from git: it holds your résumé,
# salary floor and recruiter threads. Never commit its contents.
DABJOB_DATA_DIR=data

# Bind address. Anything that is not loopback requires DABJOB_ALLOW_REMOTE=1,
# and the process refuses to start without it.
DABJOB_HOST=127.0.0.1
DABJOB_PORT=8000
DABJOB_ALLOW_REMOTE=0

# Per-install token for the bookmarklet ingest endpoint. Empty until M2.
DABJOB_TOKEN=

# Analysis transport: manual | http | cli. Read from M3 onward.
# `manual` needs nothing and is the default.
AGENT_PROVIDER=manual
