# Copy to .env and adjust. Every variable except AGENT_PROVIDER is
# prefixed with DABJOB_ so a stray shell variable cannot reconfigure the app.

# Where the SQLite database lives. Excluded from git: it holds your résumé,
# salary floor and recruiter threads. Never commit its contents.
DABJOB_DATA_DIR=data

# Bind address. Anything that is not loopback requires DABJOB_ALLOW_REMOTE=1,
# and the process refuses to start without it.
DABJOB_HOST=127.0.0.1
DABJOB_PORT=8000
DABJOB_ALLOW_REMOTE=0

# Per-install token for the bookmarklet ingest endpoint. Empty until M2.
DABJOB_TOKEN=

# Analysis transport. `manual` needs nothing and is the default; it returns
# an empty draft you fill in. The `cli` transport arrives in M8.
AGENT_PROVIDER=manual

# Only used when AGENT_PROVIDER=http. Any endpoint that speaks
# /v1/chat/completions: Ollama, LM Studio, vLLM, OpenRouter, DeepSeek.
AGENT_BASE_URL=http://127.0.0.1:11434/v1
# Required when the provider is http: a model name the endpoint knows.
AGENT_MODEL=
# Optional bearer token.
AGENT_API_KEY=
# Extra request headers as a JSON object. OpenCode Zen asks every client for
# x-opencode-session and says requests without it may start failing:
# AGENT_HEADERS={"x-opencode-session": "your-session-id"}
AGENT_HEADERS={}
